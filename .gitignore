# ---------- 日记内容（本仓库不存放任何日记正文）----------
diaries/

# ---------- 本地配置（含个人路径、窗口位置、上次打开的日期）----------
settings.json
settings.local.json
*.local.json

# ---------- 本机环境留下的隐藏目录（编辑器配置、终端历史、会话缓存）----------
.[!.]*/
!.github/

# ---------- 本机规则与说明文件（只属于我这台机器，不进公开仓库）----------
AGENTS.md
*.instructions.md
*.rules.md
*.chat.history.md
chat-history/

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 运行时、打包产物与缓存（体积大、可重建）----------
runtime/
*.exe
build/
dist/
*.spec
.webview-data/
__pycache__/
*.pyc
*.pyo

# ---------- 应用运行时产生的临时文件 ----------
*.tmp
boot.log
Diary-error.log
stacks.txt
.sync_block.js
_incident/

# ---------- 系统垃圾 ----------
Thumbs.db
desktop.ini
.DS_Store
